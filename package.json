{
  "name": "facet",
  "version": "0.1.0",
  "private": true,
  "description": "A local, paginated research writing workspace",
  "author": "Facet",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run tests/model.test.ts tests/storage.test.ts",
    "test:e2e": "playwright test",
    "pack": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac --arm64 --x64",
    "dist:win": "pnpm build && electron-builder --win --x64"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/extension-highlight": "^3.0.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "studio.facet.desktop",
    "productName": "Facet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "Tex-Template",
        "to": "Tex-Template",
        "filter": [
          "guide.sty",
          "LICENSE"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "facet",
        "name": "Facet document",
        "role": "Editor"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Facet-${version}-win-${arch}-setup.${ext}"
    },
    "artifactName": "Facet-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Facet-${version}-win-${arch}-portable.${ext}"
    }
  },
  "packageManager": "pnpm@11.19.0"
}
